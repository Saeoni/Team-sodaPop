<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/Menus/menus.uss?fileID=7433441132597879392&amp;guid=54a4342caf1d45844b600b9897b739ca&amp;type=3#menus" />
    <ui:VisualElement name="MenuContainer" enabled="true" class="scrim-and-all scrim--fadein" style="display: flex; visibility: visible; overflow: visible; -unity-text-auto-size: best-fit 10px 100px;">
        <ui:VisualElement name="PauseMenu" style="flex-grow: 1; flex-shrink: 1; background-color: rgba(0, 0, 0, 0.75); background-size: 100% 100%; -unity-text-align: upper-center; opacity: 1; display: flex; padding-top: 0; align-items: auto; flex-direction: row; background-position-x: center; align-content: center; align-self: auto;">
            <ui:VisualElement name="SidebarContainer" style="flex-grow: 1; align-self: flex-start; align-content: auto; padding-top: 213px; padding-left: 122px;">
