                    <ui:Label text="PAUSE" name="Menu_Title" selectable="false" focusable="false" double-click-selects-word="false" triple-click-selects-line="false" class="Menus" style="border-bottom-width: 2px; border-bottom-color: rgb(122, 95, 95);" />
                </ui:VisualElement>
                <ui:VisualElement name="ButtonContainer" style="align-self: flex-start; width: 340px; align-items: auto; justify-content: flex-start; align-content: flex-start;">
                    <ui:Button text="Resume" name="Button_Resume" selectable="true" focusable="true" class="buttons button_resume" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                    <ui:Button text="Restart" name="Button_Restart" selectable="true" focusable="true" tabindex="1" class="buttons buttons_restart" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                    <ui:Button text="Quit" name="Button_Quit" selectable="true" tabindex="2" class="buttons" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                    <ui:Button text="Respawn" name="Button_Respawn" selectable="true" focusable="true" tabindex="3" class="buttons buttons_respawn" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                    <ui:Button text="Menu" name="Button_Main_Menu" selectable="true" focusable="true" tabindex="1" class="buttons" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="OptionsContainer" style="background-image: url(&quot;project://database/Assets/Unity%20Store%20DL/Cartoon_Texture_Pack/SAND/SAND_Underwater/Textures/Sand_Underwater_Base_height.png?fileID=2800000&amp;guid=59f512951b3979d498aea3bb88d8806d&amp;type=3#Sand_Underwater_Base_height&quot;); -unity-background-image-tint-color: rgba(37, 35, 35, 0.84); -unity-background-scale-mode: stretch-to-fill; width: 59%; height: 72%; align-self: center; align-items: auto; justify-content: center; margin-right: 204px; margin-top: 56px; flex-direction: row;">
                <ui:ToggleButtonGroup label="Toggle Button Group" name="ToggleButtonGroup" is-multiple-selection="true" value="0" style="align-self: flex-start;" />
                <ui:VisualElement name="OptionsCanvas" style="flex-grow: 1; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; background-image: url(&quot;project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&amp;guid=906fed77d26fb6949a29657f2515367e&amp;type=3#1-Smoke&quot;); width: 100%; height: 100%; -unity-background-image-tint-color: rgb(167, 149, 149); border-left-color: rgba(45, 45, 45, 0.16); border-right-color: rgba(45, 45, 45, 0.16); border-top-color: rgba(45, 45, 45, 0.16); border-bottom-color: rgba(45, 45, 45, 0.16); border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; background-color: rgba(0, 0, 0, 0.15);">
