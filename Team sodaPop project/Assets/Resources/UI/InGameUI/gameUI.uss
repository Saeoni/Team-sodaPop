:root {
}

#VisualElement {
}

.objectives {
    flex-grow: 1;
    width: 200px;
    height: 200px;
    align-self: flex-end;
    justify-content: flex-start;
    margin-top: 35px;
    align-items: auto;
    flex-direction: column;
    align-content: flex-start;
    -unity-text-align: upper-right;
    white-space: normal;
    text-overflow: clip;
}

.game-goal {
    flex-grow: initial;
    height: 40px;
    flex-direction: row;
    -unity-text-align: upper-right;
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
    white-space: normal;
    background-position-y: center;
    opacity: 1;
    -unity-background-image-tint-color: rgba(223, 190, 190, 0.36);
}

.key {
    flex-grow: initial;
    height: 40px;
    flex-direction: row;
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
    text-overflow: clip;
}

.health {
    height: 47px;
    width: 504px;
    align-self: center;
    background-image: resource('Player/Sprites/health-bar-fill');
    -unity-background-image-tint-color: rgba(32, 228, 41, 0.18);
    background-position-x: left 0;
    background-size: 100% 100%;
    flex-shrink: initial;
    max-width: 100%;
    max-height: 100%;
}

.reticle-x {
    flex-grow: 1;
    width: 35px;
    align-self: center;
    height: 2px;
    background-color: rgb(41, 181, 27);
    left: auto;
    justify-content: space-between;
    align-items: stretch;
    align-content: center;
}

.healthbar-container {
    position: absolute;
    top: 917px;
    left: 114px;
    width: 454px;
    background-image: resource('Player/Sprites/health-bar');
    height: 61px;
    -unity-background-image-tint-color: rgb(255, 0, 0);
    align-items: center;
    background-color: rgba(0, 0, 0, 0.38);
    flex-grow: 1;
}

.progress-bar {
    color: rgb(218, 0, 0);
    -unity-text-auto-size: none;
    font-size: 20px;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-items: stretch;
    flex-grow: 1;
    flex-basis: auto;
    background-color: rgb(55, 14, 14);
    background-position-x: right 0;
}
