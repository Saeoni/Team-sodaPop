:root {
    position: relative;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    align-content: stretch;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/Witchwoode-Regular.ttf?fileID=12800000&guid=0a10106fc090396478d1ca0a2abe3ee0&type=3#Witchwoode-Regular");
    color: rgb(255, 255, 255);
    font-size: 150px;
    -unity-text-align: upper-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-wrap: nowrap;
    width: 100%;
    height: auto;
    padding-bottom: 0;
    top: 0;
    position: relative;
    align-items: center;
    align-self: center;
    align-content: center;
    justify-content: flex-end;
}

.subtitle {
    -unity-font-definition: url("project://database/Assets/Fonts/savage_3/Savage.ttf?fileID=12800000&guid=f007fef26dd2df744959f70d7c90d6b1&type=3#Savage");
    font-size: 64px;
    -unity-text-align: middle-center;
    margin-top: 228px;
    visibility: visible;
    overflow: visible;
    display: flex;
    flex-shrink: initial;
    flex-grow: initial;
    flex-basis: auto;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    white-space: normal;
    transform-origin: top;
}

.button {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    position: relative;
    -unity-background-image-tint-color: rgb(74, 72, 72);
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
    color: rgb(127, 42, 42);
    -unity-text-align: upper-center;
    -unity-font-style: normal;
    background-size: 100% 100px;
    transition-duration: 0.01s;
    transition-timing-function: ease-in-out;
    -unity-font-definition: url("project://database/Assets/Fonts/kishore-sharp.ttf?fileID=12800000&guid=990e3c335eec5fe47a091848ad1ddeaa&type=3#kishore-sharp");
    font-size: 50px;
    width: 300px;
    align-self: center;
    align-content: stretch;
    height: 75px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    white-space: normal;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    top: 0;
    bottom: auto;
    text-overflow: clip;
    visibility: visible;
    flex-shrink: 1;
    flex-grow: initial;
    flex-wrap: nowrap;
    display: flex;
}

.button:hover {
    color: rgb(255, 0, 0);
    scale: 1.1 1.1;
    bottom: auto;
    position: relative;
    letter-spacing: 13px;
    border-left-color: rgb(143, 99, 99);
    border-right-color: rgb(143, 99, 99);
    border-top-color: rgb(143, 99, 99);
    border-bottom-color: rgb(143, 99, 99);
    translate: 0 0;
    background-position-x: left -25px;
}

.startbutton {
    color: rgb(221, 127, 130);
}

.startbutton:hover {
    color: rgb(10, 255, 45);
}

.scrim2 {
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgb(91, 74, 74);
    transition-duration: 15s;
    transition-timing-function: ease;
    justify-content: center;
    align-content: auto;
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    position: absolute;
    top: 0;
    flex-wrap: wrap;
}

.scrim2--smokey {
    transition-duration: 15s;
    background-size: 100% 100%;
    translate: 0 -184px;
    -unity-background-image-tint-color: rgb(138, 44, 44);
    transition-timing-function: ease;
    width: auto;
    height: auto;
    align-items: stretch;
    position: absolute;
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
}

.scrim1 {
    background-image: url("project://database/Assets/Unity%20Store%20DL/Hits%20Effects%20FREE/Textures/1-Smoke.tiff?fileID=2800000&guid=906fed77d26fb6949a29657f2515367e&type=3#1-Smoke");
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-size: 200% 200%;
    transition-duration: 15s;
    top: 0;
}

.scrim1--smokey {
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgb(83, 71, 71);
    transition-duration: 15s;
    transition-timing-function: ease;
}
