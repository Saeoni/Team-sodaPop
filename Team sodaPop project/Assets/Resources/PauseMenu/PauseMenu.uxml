                <ui:Button text="Quit" name="QuitButton" class="buttons" style="width: 200px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/savage_3/Savage.ttf?fileID=12800000&amp;guid=f007fef26dd2df744959f70d7c90d6b1&amp;type=3#Savage&quot;); font-size: 45px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-image: url(&quot;project://database/Assets/Unity%20Store%20DL/Demon%20Horror%20Creature%20with%20Weapon/Textures/Demon_tex/Demon_damaged_tex/Demon2_Metallic.png?fileID=2800000&amp;guid=8f48557740b087543a414c91a8a036e4&amp;type=3#Demon2_Metallic&quot;); -unity-background-image-tint-color: rgba(138, 132, 132, 0.98); color: rgb(255, 255, 255);" />
            </ui:VisualElement>
