                </ui:VisualElement>
                <ui:VisualElement name="Keys" style="flex-grow: initial; height: 40px; align-self: stretch; align-items: center; justify-content: flex-start; flex-direction: row;">
                    <ui:Label text="Keys:" name="KeysLabel" style="color: rgb(255, 255, 255); font-size: 24px;" />
                    <ui:Label text="00" name="key_count_text" style="font-size: 24px; color: rgb(255, 0, 0);" />
